# ---------------------------------------------------------------------------
# Copy to .env and fill in. Everything the app reads is listed here.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=slo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=slovenscina
# For local development against the compose database, expose port 5432 first.
DATABASE_URL=postgres://slo:change-me@localhost:5432/slovenscina

# --- Sessions ---------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=90

# --- Media ------------------------------------------------------------------
# Generated TTS audio, human recordings and speech attempts live here.
MEDIA_ROOT=./media

# --- Text to speech (Piper) — build step 4 ----------------------------------
# Leave PIPER_URL empty to run without TTS; audio features degrade, nothing breaks.
PIPER_URL=
PIPER_VOICE=sl_SI-artur-medium

# --- Speech recognition (faster-whisper) — build step 5 ---------------------
# Leave WHISPER_URL empty and speaking exercises fall back to self-assessment.
WHISPER_URL=
# small | medium | large-v3. Slovene accuracy improves noticeably above small.
WHISPER_MODEL=medium

# --- AI content generation (teacher-side only) — build step 9 ---------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Weekly digest email — build step 10 ------------------------------------
DIGEST_ENABLED=false
SMTP_URL=
DIGEST_EMAIL_TO=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
APP_PORT=3000
# Set to false to skip automatic migrations at startup.
RUN_MIGRATIONS_ON_START=true

# --- Account seeding (pnpm seed:users) --------------------------------------
# Passwords are optional; a strong one is generated and printed if omitted.
LEARNER_EMAIL=
LEARNER_NAME=
LEARNER_PASSWORD=
TEACHER_EMAIL=
TEACHER_NAME=
TEACHER_PASSWORD=
