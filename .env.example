# ---------------------------------------------------------------------------
# Copy to .env and fill in. Everything the app reads is listed here.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=slo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dober_dan
# For local development against the compose database, expose port 5432 first.
DATABASE_URL=postgres://slo:change-me@localhost:5432/dober_dan
# The PGlite development database (pnpm dev:db) serves one connection at a time.
# Set this to 1 when pointing at it; leave unset for real PostgreSQL.
DB_POOL_MAX=

# --- Sessions ---------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=90

# --- Media ------------------------------------------------------------------
# Generated TTS audio, human recordings and speech attempts live here.
MEDIA_ROOT=./media

# --- Text to speech (Piper) -------------------------------------------------
# Leave PIPER_URL empty to run without TTS; listening exercises disappear
# rather than failing. Under docker compose this is set for you.
PIPER_URL=
# The only Slovene voice Piper ships (single speaker, CC BY 4.0).
PIPER_VOICE=sl_SI-artur-medium

# --- Speech recognition (faster-whisper) ------------------------------------
# Leave WHISPER_URL empty and speaking exercises fall back to self-assessment:
# the recording is still stored, she just judges it herself.
# Under docker compose this is set for you.
WHISPER_URL=
# small | medium | large-v3. Slovene accuracy improves noticeably above small,
# which is why medium is the default. small suits a constrained host.
WHISPER_MODEL=medium
# int8 is the sensible CPU default; float32 is slower and barely better here.
WHISPER_COMPUTE_TYPE=int8

# --- AI content generation (teacher-side only) — build step 9 ---------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Weekly digest ----------------------------------------------------------
# The digest is always available in the teacher area and via `pnpm digest:run`.
# DIGEST_ENABLED turns on the in-process weekly scheduler; leave it false and
# run the script from cron or a Kubernetes CronJob instead.
DIGEST_ENABLED=false
DIGEST_DAY=sunday
DIGEST_HOUR=18
# The digest lands at a real local time, so it needs a real timezone.
DIGEST_TIMEZONE=Europe/Berlin
# Email is optional. Without SMTP_URL and DIGEST_EMAIL_TO nothing is sent and
# the digest simply waits in the app.
SMTP_URL=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
# Absolute URL of the app, for the link in the digest email.
APP_URL=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
APP_PORT=3000
# Set to false to skip automatic migrations at startup.
RUN_MIGRATIONS_ON_START=true

# --- Account seeding (pnpm seed:users) --------------------------------------
# Passwords are optional; a strong one is generated and printed if omitted.
LEARNER_EMAIL=
LEARNER_NAME=
LEARNER_PASSWORD=
TEACHER_EMAIL=
TEACHER_NAME=
TEACHER_PASSWORD=
